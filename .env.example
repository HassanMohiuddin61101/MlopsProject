# Binance API Configuration
BINANCE_TARGET=BTCUSDT

# Optional: Binance API Credentials (for authenticated API access)
# Leave empty to use public API (rate-limited)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False

# MLflow & Dagshub Configuration
MLFLOW_TRACKING_URI=https://dagshub.com/username/repo-name.mlflow
DAGSHUB_USER_TOKEN=your_dagshub_token_here

# Airflow Configuration
AIRFLOW_HOME=./airflow
